rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unmapped access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gaurav.ssc@gmail.com' ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'gaurav.ssc@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'role', 'approved']) &&
        data.keys().hasOnly(['email', 'role', 'approved', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.email is string && data.email.size() <= 128 &&
        data.role in ['admin', 'speller_parent'] &&
        data.approved is bool;
    }

    function isValidSpellerProfile(data, userId) {
      return data.keys().hasAll(['id', 'name', 'difficultyLevel']) &&
        data.id is string && data.id.size() <= 64 &&
        (!('userId' in data) || data.userId == userId || isAdmin()) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        (!('age' in data) || (data.age is number && data.age >= 1 && data.age <= 100)) &&
        data.difficultyLevel is number && data.difficultyLevel >= 1 && data.difficultyLevel <= 5 &&
        (!('struggledWords' in data) || (data.struggledWords is list && data.struggledWords.size() <= 500)) &&
        (!('masteredWords' in data) || (data.masteredWords is list && data.masteredWords.size() <= 2000));
    }

    function isValidWordHistory(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'spellerId', 'word', 'status', 'timestamp']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId == userId &&
        data.spellerId is string && data.spellerId.size() <= 64 &&
        data.word is string && data.word.size() > 0 && data.word.size() <= 50 &&
        data.status in ['correct', 'wrong'] &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    function isValidApprovedUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.email is string && data.email.size() <= 128 &&
        data.role in ['admin', 'speller_parent'];
    }

    function isValidWordBankLevel(data) {
      return data.keys().hasAll(['level', 'words']) &&
        data.keys().hasOnly(['level', 'words', 'updatedAt']) &&
        data.level is number && data.level >= 1 && data.level <= 5 &&
        data.words is list && data.words.size() <= 250 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidTtsCache(data) {
      return data.keys().hasAll(['word', 'voice', 'audio']) &&
        data.keys().hasOnly(['word', 'voice', 'audio', 'format', 'createdAt']) &&
        data.word is string && data.word.size() > 0 && data.word.size() <= 64 &&
        data.voice is string && data.voice.size() > 0 && data.voice.size() <= 32 &&
        data.audio is string && data.audio.size() > 0 && data.audio.size() <= 200000 &&
        (!('format' in data) || (data.format is string && data.format.size() <= 32)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidSharedProfile(data) {
      return data.keys().hasAll(['id', 'name', 'difficultyLevel']) &&
        data.id is string && data.id.size() <= 64 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        (!('age' in data) || (data.age is number && data.age >= 1 && data.age <= 100)) &&
        data.difficultyLevel is number && data.difficultyLevel >= 1 && data.difficultyLevel <= 5 &&
        (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
        (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 128)) &&
        (!('collaboratorEmails' in data) || (data.collaboratorEmails is list && data.collaboratorEmails.size() <= 50)) &&
        (!('sharedWithEmails' in data) || (data.sharedWithEmails is list && data.sharedWithEmails.size() <= 50)) &&
        (!('struggledWords' in data) || (data.struggledWords is list && data.struggledWords.size() <= 500)) &&
        (!('masteredWords' in data) || (data.masteredWords is list && data.masteredWords.size() <= 2000));
    }

    // 1. User Account Documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data) && (
        (request.resource.data.role == 'admin' && isAdmin()) ||
        request.resource.data.role == 'speller_parent'
      );
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data) && (
        request.resource.data.role == resource.data.role || isAdmin()
      );
      allow delete: if isAdmin();

      // 2. Speller Profiles Subcollection
      match /profiles/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidSpellerProfile(request.resource.data, userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // 3. Word History Subcollection (Immutable Logs)
      match /word_history/{historyId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) && isValidWordHistory(request.resource.data, userId);
        allow update: if false; // Word history records are strictly append-only
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // 4. Approved Whitelist Entries
    match /approved_users/{emailId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 5. Word Bank Levels
    match /word_bank/{levelId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidWordBankLevel(request.resource.data);
      allow delete: if isAdmin();
    }

    // 6. TTS Audio Cache
    match /tts_cache/{wordKey} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidTtsCache(request.resource.data);
      allow delete: if isAdmin();
    }

    // 7. Shared Speller Profiles
    match /shared_profiles/{profileId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (request.auth.token.email != null && (
          ('ownerEmail' in resource.data && resource.data.ownerEmail == request.auth.token.email.lower()) ||
          ('collaboratorEmails' in resource.data && (
            request.auth.token.email.lower() in resource.data.collaboratorEmails ||
            request.auth.token.email in resource.data.collaboratorEmails
          ))
        ))
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidSharedProfile(request.resource.data) && (
        isAdmin() ||
        ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
        (request.auth.token.email != null && (
          ('ownerEmail' in request.resource.data && request.resource.data.ownerEmail == request.auth.token.email.lower()) ||
          ('collaboratorEmails' in request.resource.data && (
            request.auth.token.email.lower() in request.resource.data.collaboratorEmails ||
            request.auth.token.email in request.resource.data.collaboratorEmails
          ))
        ))
      );
      allow update: if isSignedIn() && isValidSharedProfile(request.resource.data) && (
        isAdmin() ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
        (request.auth.token.email != null && (
          ('ownerEmail' in resource.data && resource.data.ownerEmail == request.auth.token.email.lower()) ||
          ('collaboratorEmails' in resource.data && (
            request.auth.token.email.lower() in resource.data.collaboratorEmails ||
            request.auth.token.email in resource.data.collaboratorEmails
          )) ||
          ('collaboratorEmails' in request.resource.data && (
            request.auth.token.email.lower() in request.resource.data.collaboratorEmails ||
            request.auth.token.email in request.resource.data.collaboratorEmails
          ))
        ))
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
      );

      // Subcollection: Shared Speller History Records
      match /history/{historyId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if isSignedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/shared_profiles/$(profileId)).data.ownerId == request.auth.uid
        );
      }
    }
  }
}
